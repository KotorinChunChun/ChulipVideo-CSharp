  "runtimes": [
    {
      "id": "dotnet-desktop",
      "name": ".NET Desktop Runtime 10 (x64)",
      "kind": "dotnet-desktop",
      "major": 10,
      "guide": "開発実行には.NET 10 SDK、フレームワーク依存EXEには.NET Desktop Runtime 10 x64が必要です。"
    },
    {
      "id": "ffmpeg",
      "name": "FFmpeg",
      "kind": "external",
      "optional": true,
      "feature": "動画の読込・書き出し",
      "guide": "設定でlibx264対応FFmpeg実行ファイルを指定してください。本体のSSCapture専用FFmpeg導入とは別設定です。"
    }
  ]
